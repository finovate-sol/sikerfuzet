{
  "manifest_version": 3,
  "name": "Sikerfüzet → Erfolgsjournal",
  "version": "1.2.0",
  "description": "A Sikerfüzet Havi tervének számait beírja az Erfolgsjournalba (Havi képlet, heti Cél és Van).",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://erfolgsjournal.app/*"
      ],
      "js": [
        "korai.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://erfolgsjournal.app/*"
      ],
      "js": [
        "ej.js"
      ],
      "run_at": "document_idle"
    }
  ]
}