rules_version = '2';

// ============================================================================
//  SIKERFÜZET – FIREBASE STORAGE SZABÁLYOK
//
//  FIGYELEM: AZ APP JELENLEG EGYÁLTALÁN NEM HASZNÁLJA A STORAGE-OT.
//
//  A Firebase Storage BLAZE (fizetős, bankkártyás) csomagot igényel, a projekt
//  pedig Spark csomagon van – emiatt a célfal képfeltöltése sokáig néma hibával
//  hasalt el. Ezért mind a célfal, mind a jegyzetek képei a FIRESTORE-ba
//  kerülnek, képenként külön dokumentumban (cel_images / note_images), lásd a
//  firestore.rules-t. Ehhez a fájlhoz nem kell hozzányúlni, és a Storage-ot nem
//  kell bekapcsolni.
//
//  A fájl azért marad meg, mert egy esetleges Blaze-váltás után a képek
//  visszakerülhetnek ide (az auth.js-ben az uploadCelKep / uploadNoteImage
//  függvények is megvannak még). Akkor: Build → Storage → Get started, majd
//  Rules → Publish ezzel a tartalommal.
//
//  MIÉRT ENNYIRE EGYSZERŰ?
//  A Storage szabályai NEM tudnak a Firestore-ból olvasni: nem látják sem az
//  allowed_users allowlistát, sem a config/access felettes-térképet. Ezért itt
//  nem lehet ugyanazt a jogosultsági logikát lemásolni, ami a firestore.rules-ban
//  van. A döntés ezért tudatos:
//
//    • ÍRNI és TÖRÖLNI csak a saját mappájába tud valaki (celfal/{saját uid}/…).
//    • OLVASNI bármelyik bejelentkezett felhasználó tud – így működik a vezetői
//      "ránézés" is, anélkül hogy a felettes-láncot itt újra le kellene képezni.
//
//  A célfal motivációs kép (autó, ház, nyaralás), nem ügyféladat – ezt a
//  kompromisszumot erre a tartalomra szabtuk. Ha ide valaha érzékeny tartalom
//  kerülne, ez a szabály kevés lesz hozzá.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Célfal: celfal/{uid}/{fájlnév}
    match /celfal/{userId}/{fileName} {
      allow read: if request.auth != null;

      // Feltöltés/felülírás: csak a gazdája, csak kép, legfeljebb 8 MB.
      // (Az app amúgy is ~200 kB-ra méretezi a képet feltöltés előtt.)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Törlésnél nincs request.resource, ezért kell külön sor – a fenti
      // méret/típus feltétel önmagában minden törlést elutasítana.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Jegyzet-képek: jegyzet/{uid}/{fájlnév}
    //
    // A célfallal ellentétben itt az OLVASÁS IS csak a gazdáé. A jegyzet
    // magánjegyzet, és szerencsére ehhez nem kell a Firestore-t látni: elég a
    // bejelentkezett uid összevetése az útvonallal, amit a Storage tud.
    match /jegyzet/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Feltöltés: csak a gazdája, csak kép, legfeljebb 8 MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Törlésnél nincs request.resource – lásd a célfalnál írt magyarázatot.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Minden más útvonal tiltva.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
